# Source material under analysis - never commit or push these repos (one is private)
temp-to-analyse/

# The record itself lives OUTSIDE this repo, in the sibling <repo>_claude_iff/ folder, so it
# needs no ignore rule: git cannot reach it at all. Only the anchor and the redacted daily
# rollups live in .claude-iff/, and those are meant to be committed.

# Private reference material (personal brand guides, drafts) - reusable locally, never published
.claude/reference/private/

# The secrets safety net, console runtime, heartbeat, worktrees and python caches live in the
# managed block below (visibility: tracked); `distctl.py gitignore --apply` rewrites it.

# >>> dot-claude-iff managed block: `python3 .claude/tools/distctl.py gitignore --apply` rewrites it; put your own rules outside it
# visibility: tracked - .claude/ is committed with the project; only per-user and derived files stay out

# Safety net: secrets and machine-local settings, wherever they appear
.env
*.env
.env*.local
settings.local.json

# Console runtime
.claude/console/*.pid
.claude/console/*.log

# Liveness signal, rewritten every turn by the Stop hook (which creates it when missing)
.claude/state/heartbeat.json

# Ritual ticket: minted by the prompt hook when the user types /project-memory, consumed at the end
.claude/state/ritual-ticket.json

# Orchestration runtime (agent start times, the delegation counter), rewritten by hooks
.claude/state/orchestration.json

# Projections of the journal, rebuilt by statectl on every write and at session start; the
# journal itself stays tracked. Ignored so a checkout that only ran a session ends clean and a
# worktree's stale copy never merges back (Cview's merge refuses a dirty main checkout)
.claude/state/session.json
.claude/state/HANDOFF.md
.claude/state/needs-human.json

# Agent worktrees (build-time scratch copies of the repo; a Cview task's worktree lives here too)
.claude/worktrees/

# Atomic-write leftovers (the temp file of a write that died before its rename)
.claude/**/*.tmp

# Python caches
__pycache__/
*.pyc
# <<< dot-claude-iff managed block
